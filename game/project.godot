; Re - Traveller : SAMPLE GAME PROJECT (Project B, minimal)
; Its only job in Phase 1 is to prove the launcher pipeline end to end:
; it is packed with PCKPacker into core/characters/enemies/world/ui/audio .pck
; files, downloaded, hash-verified, loaded and booted by the launcher.
;
; NOTE: every game file lives under res://game/ so a package can never shadow a
; launcher file. This rule is enforced by the launcher (see PackLoader.gd).

config_version=5

[application]

config/name="Re - Traveller (paket contoh)"
config/description="Paket contoh untuk menguji peluncur."
run/main_scene="res://game/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.1.0"

[debug]

gdscript/warnings/treat_warnings_as_errors=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
